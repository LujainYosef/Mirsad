# Copy this file to `.env` for local development and fill in real values.
# Never commit the real `.env` file to GitHub — it is already listed in .gitignore.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: which model OpenRouter should route to. Any OpenRouter model
# slug works; pick one that supports vision if you want image evidence
# (screenshots/phishing emails) to be analyzed directly.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional: shown to OpenRouter for attribution/rankings, not required.
APP_PUBLIC_URL=http://localhost:8000
APP_TITLE=Mirsad

# Optional: server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional: upload / evidence limits
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=5
MAX_TEXT_EVIDENCE_CHARS=60000
MAX_PDF_CHARS=40000
MAX_CHAT_HISTORY_TURNS=12

# Optional: how long an investigation case stays in memory for follow-up chat (seconds)
CASE_TTL_SECONDS=21600
